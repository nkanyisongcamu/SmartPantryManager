<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F7F9F7">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="27sp"
        android:textStyle="bold"/>

    <Switch
        android:id="@+id/switchExpiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Expiring-soon alerts"
        android:layout_marginTop="25dp"/>

    <TextView
        android:id="@+id/txtSettingsInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Your preference is saved locally on this device."/>

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Pantry"
        android:layout_marginTop="25dp"/>
</LinearLayout>
